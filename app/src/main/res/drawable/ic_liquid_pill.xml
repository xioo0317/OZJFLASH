<?xml version="1.0" encoding="utf-8"?>
<!--
  主题设置「液态胶囊」条目图标：一个横向 USB 胶囊轮廓，左侧中部一个实心状态点。
  极简两笔，刻意不画文字线，呼应 ColorOS 设备状态胶囊的识别形态。
  路径颜色固定为不透明白，交由 Icon(painter, tint=...) 以 ColorFilter(SrcIn)
  统一染成 colorScheme.onBackground，随深浅主题自动适配。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 胶囊跑道形轮廓：上/下直线 + 左/右半圆，圆心 y=12，半径 5 -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:pathData="M8.5,7 L15.5,7 A5,5 0 0,1 15.5,17 L8.5,17 A5,5 0 0,1 8.5,7 Z" />
    <!-- 左侧状态点：圆心 (7.5,12)，半径 1.9，实心 -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M7.5,10.1 A1.9,1.9 0 1,1 7.5,13.9 A1.9,1.9 0 1,1 7.5,10.1 Z" />
</vector>
